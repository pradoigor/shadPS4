<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled"
      Background="#080B13">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#171C29"/>
      <Setter Property="BorderBrush" Value="#30384B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F5F7FC"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
      <Setter Property="FocusVisualPrimaryBrush" Value="#E5F2FF"/>
      <Setter Property="FocusVisualSecondaryBrush" Value="#29A8FF"/>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Viewbox Stretch="Uniform">
    <Grid Width="1600" Height="900" Background="#080B13">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid x:Name="HomeView" Margin="54,24,54,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="120"/>
          <RowDefinition Height="94"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="52"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
            <Border Width="44" Height="44" CornerRadius="12" Background="#101827">
              <Image Width="40" Height="40" Source="ms-appx:///Assets/XS4-Mark.png" Stretch="Uniform"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="XS4" FontSize="27" FontWeight="SemiBold" CharacterSpacing="70"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="GamesTab" Content="GAMES" Padding="20,12" Background="#176EC0" BorderBrush="#3CA5FF"/>
            <Button x:Name="AppsTab" Content="APLICATIVOS" Padding="20,12"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="OpenLibrary" Width="54" Height="54" Padding="0" Content="＋" FontSize="29" AutomationProperties.Name="Abrir biblioteca e importar"/>
            <Button x:Name="OpenSettings" Width="54" Height="54" Padding="0" Content="⚙" FontSize="26" AutomationProperties.Name="Configurações"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,12">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="HomeTitle" Text="Seus games" FontSize="31" FontWeight="Light"/>
            <TextBlock x:Name="HomeSubtitle" Text="Escolha um título para iniciar" FontSize="14" Foreground="#9AA7BC"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8">
            <TextBlock x:Name="HomeCount" Text="0 TÍTULOS" FontSize="10" CharacterSpacing="100" Foreground="#8190A8" HorizontalAlignment="Right"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button x:Name="FilterAll" Content="Tudo" Padding="15,8" FontSize="14" Background="#222A3A"/>
              <Button x:Name="FilterFavorites" Content="★ Favoritos" Padding="15,8" FontSize="14"/>
              <Button x:Name="FilterRecent" Content="Recentes" Padding="15,8" FontSize="14"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <ItemsControl x:Name="HomeItems" XYFocusKeyboardNavigation="Enabled">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="242" ItemHeight="242"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="HomeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="HomeEmptyGlyph" Text="◇" FontSize="56" Foreground="#3E526D" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HomeEmptyTitle" Text="Sua biblioteca está vazia" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HomeEmptyDescription" Text="Use + para importar um PKG e instalar seu primeiro título." FontSize="15" Foreground="#9AA7BC" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="560"/>
            <Button x:Name="EmptyImport" Content="＋  Abrir biblioteca" HorizontalAlignment="Center" Margin="0,8,0,0" Background="#176EC0" BorderBrush="#3CA5FF"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <Border x:Name="HomeNotice" Background="#182235" BorderBrush="#29364E" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="HomeNoticeText" FontSize="13" Foreground="#DCE8F8" TextWrapping="Wrap" MaxWidth="900"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="22">
            <TextBlock Text="Ⓐ  Abrir" FontSize="14" Foreground="#BEC8D8"/>
            <TextBlock Text="Ⓑ  Voltar" FontSize="14" Foreground="#BEC8D8"/>
            <TextBlock Text="Ⓨ  Favoritar" FontSize="14" Foreground="#BEC8D8"/>
            <TextBlock Text="LB / RB  Categorias" FontSize="14" Foreground="#BEC8D8"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="LibraryView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="84"/>
          <RowDefinition Height="84"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="118"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
            <Button x:Name="LibraryBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="Biblioteca" FontSize="30" FontWeight="Light"/>
              <TextBlock Text="Pacotes e arquivos que ainda aguardam instalação" FontSize="13" Foreground="#9AA7BC"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="ImportKeys" Content="Importar chaves" Padding="16,10"/>
            <Button x:Name="SelectContent" Content="＋  Importar arquivos" Padding="18,12" Background="#176EC0" BorderBrush="#3CA5FF"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,12">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock x:Name="PendingHeading" Text="AGUARDANDO INSTALAÇÃO" FontSize="13" CharacterSpacing="120" Foreground="#93A4BE"/>
            <TextBlock x:Name="PendingCount" Text="0 arquivos" FontSize="14" Foreground="#CFD8E6"/>
          </StackPanel>
          <TextBlock x:Name="LibraryStatus" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="620" FontSize="13" TextWrapping="Wrap" Foreground="#AFC4DE" TextAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto">
            <ItemsControl x:Name="PendingItems" XYFocusKeyboardNavigation="Enabled">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="242" ItemHeight="242"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="PendingEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="＋" FontSize="52" Foreground="#3E526D" HorizontalAlignment="Center"/>
            <TextBlock Text="Nenhum arquivo aguardando" FontSize="23" HorizontalAlignment="Center"/>
            <TextBlock Text="Importe um PKG para instalar ou um ELF/SELF para validar." FontSize="15" Foreground="#9AA7BC" HorizontalAlignment="Center"/>
            <Button x:Name="PendingEmptyImport" Content="Importar arquivos" HorizontalAlignment="Center" Margin="0,8,0,0" Background="#176EC0" BorderBrush="#3CA5FF"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="#111722" BorderBrush="#252E3D" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,6,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock x:Name="SelectedContentTitle" Text="Selecione um arquivo" FontSize="21"/>
              <TextBlock x:Name="SelectedContentDetails" Text="Os PKGs só são extraídos; importar ou instalar nunca inicia o conteúdo." FontSize="13" Foreground="#9AA7BC" TextWrapping="Wrap" MaxWidth="900"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
              <Button x:Name="ValidateContent" Content="Validar ELF / SELF" IsEnabled="False" Padding="16,11"/>
              <Button x:Name="ExtractContent" Content="Instalar PKG" IsEnabled="False" Padding="18,12" Background="#176EC0" BorderBrush="#3CA5FF"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="24">
          <TextBlock Text="Ⓐ  Selecionar arquivo" FontSize="14" Foreground="#BEC8D8"/>
          <TextBlock Text="Ⓑ  Voltar" FontSize="14" Foreground="#BEC8D8"/>
          <TextBlock Text="⒳  Instalar" FontSize="14" Foreground="#BEC8D8"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="SettingsView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
            <Button x:Name="SettingsBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/>
            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="Configurações" FontSize="30" FontWeight="Light"/><TextBlock Text="Preferências e informações do aplicativo" FontSize="13" Foreground="#9AA7BC"/></StackPanel>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto">
          <StackPanel Spacing="18" Margin="0,14,0,10">
            <Border Background="#111722" BorderBrush="#252E3D" BorderThickness="1" CornerRadius="12" Padding="24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="7"><TextBlock Text="XS4" FontSize="22"/><TextBlock Text="Versão instalada" FontSize="13" Foreground="#9AA7BC"/><TextBlock x:Name="CurrentVersion" Text="0.78.0.0" FontSize="17" Foreground="#D7E4F5"/><TextBlock x:Name="CurrentCommit" Text="Commit local" FontSize="12" Foreground="#73839B"/></StackPanel>
                <Border Grid.Column="1" Width="72" Height="72" CornerRadius="18" Background="#101827" VerticalAlignment="Center"><Image Width="64" Height="64" Source="ms-appx:///Assets/XS4-Mark.png" Stretch="Uniform"/></Border>
              </Grid>
            </Border>
            <Border Background="#111722" BorderBrush="#252E3D" BorderThickness="1" CornerRadius="12" Padding="24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="7"><TextBlock Text="Diagnóstico e suporte" FontSize="22"/><TextBlock Text="Exporte o relatório técnico completo, incluindo a última sessão de execução, quando disponível." FontSize="14" Foreground="#9AA7BC" TextWrapping="Wrap" MaxWidth="900"/><TextBlock x:Name="SettingsStatus" FontSize="13" Foreground="#AFC4DE" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><Button x:Name="Export" Content="Exportar relatório" Padding="18,12" Background="#176EC0" BorderBrush="#3CA5FF"/><Button x:Name="OpenDiagnostics" Content="Diagnósticos avançados" Padding="18,12"/></StackPanel>
              </Grid>
            </Border>
            <Border Background="#111722" BorderBrush="#252E3D" BorderThickness="1" CornerRadius="12" Padding="24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="7"><TextBlock Text="Biblioteca e classificação" FontSize="22"/><TextBlock Text="Os títulos são separados pelas categorias declaradas em param.sfo. Alguns homebrews usam a categoria de jogo e podem aparecer em Games." FontSize="14" Foreground="#9AA7BC" TextWrapping="Wrap" MaxWidth="930"/></StackPanel>
                <Button x:Name="SettingsImportKeys" Grid.Column="1" Content="Importar chaves PKG" VerticalAlignment="Center" Padding="18,12"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="24"><TextBlock Text="Ⓐ  Abrir" FontSize="14" Foreground="#BEC8D8"/><TextBlock Text="Ⓑ  Voltar" FontSize="14" Foreground="#BEC8D8"/></StackPanel>
      </Grid>

      <Grid x:Name="DiagnosticsView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16"><Button x:Name="DiagnosticsBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/><TextBlock Text="Diagnóstico avançado" FontSize="29" FontWeight="Light" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="DeviceInfo" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#9AA7BC" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Right"/></Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button x:Name="RunSelected" Content="Executar probe" Padding="15,9"/><Button x:Name="TestAngle" Content="Testar vídeo ANGLE" Padding="15,9"/><Button x:Name="DiagnosticsExport" Content="Exportar relatório" Padding="15,9"/></StackPanel>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions><ListView Grid.Column="0" x:Name="Tests" SelectionMode="Single" IsItemClickEnabled="False" Margin="0,0,24,0" Background="#101520" BorderBrush="#252E3D" BorderThickness="1"/><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#101520" BorderBrush="#252E3D" BorderThickness="1" Padding="20"><StackPanel Spacing="14"><TextBlock x:Name="Details" Text="Selecione um probe para ver os detalhes coletados." FontSize="17" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="Os probes validam recursos específicos; não executam o arquivo importado." FontSize="14" Foreground="#9AA7BC" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
        <TextBlock x:Name="Status" Grid.Row="3" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#AFC4DE"/>
      </Grid>
    </Grid>
  </Viewbox>

  <Grid x:Name="AngleTestView" Visibility="Collapsed" Background="#050810">
    <SwapChainPanel x:Name="AnglePanel"/>
    <Border VerticalAlignment="Bottom" Background="#E60B111C" Padding="30,22">
      <Grid><StackPanel Spacing="5"><TextBlock Text="XS4 · EXECUÇÃO" FontSize="14" CharacterSpacing="110" Foreground="#8CBDEB"/><TextBlock x:Name="AngleStatus" Text="Preparando superfície…" FontSize="16" TextWrapping="Wrap"/></StackPanel><Button x:Name="CloseAngleTest" Content="Voltar" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Border>
  </Grid>

  <Grid x:Name="InstallOverlay" Visibility="Collapsed" Background="#DD05070C">
    <Border Width="650" Padding="32" Background="#141B28" BorderBrush="#354158" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="18">
        <TextBlock Text="Instalando conteúdo" FontSize="25"/>
        <TextBlock x:Name="InstallProgressText" Text="Preparando pacote…" FontSize="14" Foreground="#AAB7CB" TextWrapping="Wrap"/>
        <Grid><ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" Height="9" Foreground="#2694F3"/><TextBlock x:Name="InstallProgressPercent" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Margin="0,16,0,0" Foreground="#D7E4F5"/></Grid>
        <Button x:Name="CancelExtraction" Content="Cancelar" HorizontalAlignment="Right" Padding="22,11"/>
      </StackPanel>
    </Border>
  </Grid>
</Grid>

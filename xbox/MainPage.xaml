<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled"
      Background="#061119">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#172D38"/>
      <Setter Property="BorderBrush" Value="#35535E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F5F7FC"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Padding" Value="20,13"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
      <Setter Property="FocusVisualPrimaryBrush" Value="#E5F2FF"/>
      <Setter Property="FocusVisualSecondaryBrush" Value="#22DDD6"/>
    </Style>
    <Style x:Key="LegendBadge" TargetType="Border">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="#B51B2A43"/>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Viewbox Stretch="Uniform">
    <Grid Width="1600" Height="900" Background="#091F49">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid x:Name="HomeView">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#092456" Offset="0"/><GradientStop Color="#07509B" Offset="0.58"/><GradientStop Color="#071E55" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Image x:Name="HomeBackdrop" Opacity="0.38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D9071D46" Offset="0"/><GradientStop Color="#89072054" Offset="0.55"/><GradientStop Color="#9005183C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Grid Margin="72,34,72,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="140"/>
          <RowDefinition Height="88"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="62"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
            <Image Source="ms-appx:///Assets/XS4-Mark.png" Width="88" Height="72" Stretch="Uniform" AutomationProperties.Name="XS4"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="GamesTab" Content="Games" Padding="20,10" FontSize="26" Background="#19606A" BorderBrush="#26DCD6"/>
            <Button x:Name="AppsTab" Content="Aplicativos" Padding="20,10" FontSize="26"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="ResumeContent" Content="▶  Retomar" Visibility="Collapsed" Background="#19606A" BorderBrush="#26DCD6"/>
            <Button x:Name="EndContent" Content="■  Encerrar" Visibility="Collapsed"/>
            <Button x:Name="OpenLibrary" Width="64" Height="64" Padding="0" Content="📦" FontSize="31" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir biblioteca e instalar pacotes"/>
            <Button x:Name="OpenSettings" Width="64" Height="64" Padding="0" Content="⚙" FontSize="30" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Configurações"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,8">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="HomeTitle" Text="Seus games" FontSize="33" FontWeight="SemiBold"/>
            <TextBlock x:Name="HomeSubtitle" Text="Escolha um título para iniciar" FontSize="16" Foreground="#B8D2D9"/>
          </StackPanel>
          <TextBlock x:Name="HomeCount" Text="0 TÍTULOS" FontSize="15" CharacterSpacing="90" Foreground="#A9C7D0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled" HorizontalScrollMode="Auto" VerticalAlignment="Top" Margin="0,32,0,0">
            <ItemsControl x:Name="HomeItems" XYFocusKeyboardNavigation="Enabled">
              <ItemsControl.ItemContainerTransitions>
                <TransitionCollection><EntranceThemeTransition/></TransitionCollection>
              </ItemsControl.ItemContainerTransitions>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="HomeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="HomeEmptyGlyph" Text="◇" FontSize="64" Foreground="#6B929C" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HomeEmptyTitle" Text="Sua biblioteca está vazia" FontSize="27" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HomeEmptyDescription" Text="Abra a biblioteca para importar e instalar um título." FontSize="17" Foreground="#B8D2D9" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="620"/>
            <Button x:Name="EmptyImport" Content="Abrir biblioteca" HorizontalAlignment="Center" Margin="0,10,0,0" Background="#19606A" BorderBrush="#26DCD6"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <Border x:Name="HomeNotice" Background="#182235" BorderBrush="#29364E" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="HomeNoticeText" FontSize="13" Foreground="#DCE8F8" TextWrapping="Wrap" MaxWidth="560"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="25">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><Grid><TextBlock Text="▲" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top"/><TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/><TextBlock Text="◀" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Text="▶" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="Navegar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="A" FontSize="15" Foreground="#70D568" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Selecionar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="B" FontSize="15" Foreground="#F36868" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Voltar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="Y" FontSize="15" Foreground="#F5D45C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Favorito" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="≡" FontSize="17" Foreground="#C9E2E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="+" FontSize="13" Foreground="#C9E2E8" VerticalAlignment="Center"/><Border Style="{StaticResource LegendBadge}"><TextBlock Text="▣" FontSize="14" Foreground="#C9E2E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Início" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
          </StackPanel>
        </Grid>
        </Grid>
        <Grid x:Name="FilterOverlay" Visibility="Collapsed" Background="#D9041119">
          <Border Width="600" Padding="34" CornerRadius="18" Background="#102630" BorderBrush="#2EDDD5" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <TextBlock Text="Filtrar títulos" FontSize="30" FontWeight="SemiBold"/>
              <TextBlock Text="Escolha o que deseja ver nesta categoria" FontSize="17" Foreground="#B8D2D9"/>
              <Button x:Name="FilterAll" Content="Todos os títulos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
              <Button x:Name="FilterFavorites" Content="★  Favoritos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
              <Button x:Name="FilterRecent" Content="Recentes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
              <Button x:Name="CloseFilters" Content="Voltar" HorizontalAlignment="Right"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="LibraryView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="84"/>
          <RowDefinition Height="84"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="118"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
            <Button x:Name="LibraryBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="Biblioteca" FontSize="30" FontWeight="Light"/>
              <TextBlock Text="Pacotes e arquivos que ainda aguardam instalação" FontSize="13" Foreground="#AFCBD2"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="ImportKeys" Content="Importar chaves" Padding="16,10"/>
            <Button x:Name="SelectContent" Content="＋  Importar arquivos" Padding="18,12" Background="#19606A" BorderBrush="#26DCD6"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,12">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock x:Name="PendingHeading" Text="AGUARDANDO INSTALAÇÃO" FontSize="13" CharacterSpacing="120" Foreground="#93A4BE"/>
            <TextBlock x:Name="PendingCount" Text="0 arquivos" FontSize="14" Foreground="#CFD8E6"/>
          </StackPanel>
          <TextBlock x:Name="LibraryStatus" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="620" FontSize="13" TextWrapping="Wrap" Foreground="#AFC4DE" TextAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto">
            <ItemsControl x:Name="PendingItems" XYFocusKeyboardNavigation="Enabled">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="242" ItemHeight="242"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="PendingEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="＋" FontSize="52" Foreground="#3E526D" HorizontalAlignment="Center"/>
            <TextBlock Text="Nenhum arquivo aguardando" FontSize="23" HorizontalAlignment="Center"/>
            <TextBlock Text="Importe um PKG para instalar ou um ELF/SELF para validar." FontSize="15" Foreground="#AFCBD2" HorizontalAlignment="Center"/>
            <Button x:Name="PendingEmptyImport" Content="Importar arquivos" HorizontalAlignment="Center" Margin="0,8,0,0" Background="#19606A" BorderBrush="#26DCD6"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="#0D2630" BorderBrush="#33535D" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,6,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock x:Name="SelectedContentTitle" Text="Selecione um arquivo" FontSize="21"/>
              <TextBlock x:Name="SelectedContentDetails" Text="" FontSize="13" Foreground="#AFCBD2" TextWrapping="Wrap" MaxWidth="900"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
              <Button x:Name="ValidateContent" Content="Validar ELF / SELF" IsEnabled="False" Padding="16,11"/>
              <Button x:Name="ExtractContent" Content="Instalar PKG" IsEnabled="False" Padding="18,12" Background="#19606A" BorderBrush="#26DCD6"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="24">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><Grid><TextBlock Text="▲" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top"/><TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/><TextBlock Text="◀" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Text="▶" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="Navegar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="A" FontSize="15" Foreground="#70D568" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Selecionar arquivo" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="B" FontSize="15" Foreground="#F36868" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Voltar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="X" FontSize="15" Foreground="#64AAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Instalar" FontSize="15" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel>
        </StackPanel>
      </Grid>

      <Grid x:Name="SettingsView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
            <Button x:Name="SettingsBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/>
            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="Configurações" FontSize="30" FontWeight="Light"/><TextBlock Text="Preferências e informações do aplicativo" FontSize="13" Foreground="#AFCBD2"/></StackPanel>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto">
          <StackPanel Spacing="18" Margin="0,14,0,10">
            <Border Background="#0D2630" BorderBrush="#33535D" BorderThickness="1" CornerRadius="12" Padding="24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="7"><TextBlock Text="XS4" FontSize="24"/><TextBlock Text="Versão instalada" FontSize="14" Foreground="#AFCBD2"/><TextBlock x:Name="CurrentVersion" Text="0.105.0.0" FontSize="20" Foreground="#F2FBFC"/></StackPanel>
                <Border Grid.Column="1" Width="72" Height="72" CornerRadius="18" Background="#11313B" VerticalAlignment="Center"><Image Width="64" Height="64" Source="ms-appx:///Assets/XS4-Mark.png" Stretch="Uniform"/></Border>
              </Grid>
            </Border>
            <Border Background="#0D2630" BorderBrush="#33535D" BorderThickness="1" CornerRadius="12" Padding="24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="9" VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock Text="Diagnóstico e suporte" FontSize="24"/><TextBlock Text="Exporte o relatório técnico da última sessão para investigar falhas." FontSize="16" Foreground="#AFCBD2" TextWrapping="Wrap"/><TextBlock x:Name="SettingsStatus" FontSize="14" Foreground="#C9E2E8" TextWrapping="Wrap"/></StackPanel>
                <Button x:Name="Export" Grid.Column="1" Content="Exportar relatório" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" Background="#19606A" BorderBrush="#26DCD6"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="24"><StackPanel Orientation="Horizontal" Spacing="7"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="A" FontSize="15" Foreground="#70D568" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Abrir" FontSize="14" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="7"><Border Style="{StaticResource LegendBadge}"><TextBlock Text="B" FontSize="15" Foreground="#F36868" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Voltar" FontSize="14" Foreground="#C9E2E8" VerticalAlignment="Center"/></StackPanel></StackPanel>
      </Grid>

      <Grid x:Name="DiagnosticsView" Margin="54,24,54,20" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16"><Button x:Name="DiagnosticsBack" Content="←" Width="54" Height="54" Padding="0" FontSize="26"/><TextBlock Text="Diagnóstico avançado" FontSize="29" FontWeight="Light" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="DeviceInfo" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#AFCBD2" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Right"/></Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button x:Name="RunSelected" Content="Executar probe" Padding="15,9"/><Button x:Name="TestAngle" Content="Testar vídeo ANGLE" Padding="15,9"/><Button x:Name="DiagnosticsExport" Content="Exportar relatório" Padding="15,9"/></StackPanel>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions><ListView Grid.Column="0" x:Name="Tests" SelectionMode="Single" IsItemClickEnabled="False" Margin="0,0,24,0" Background="#102B35" BorderBrush="#33535D" BorderThickness="1"/><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#102B35" BorderBrush="#33535D" BorderThickness="1" Padding="20"><StackPanel Spacing="14"><TextBlock x:Name="Details" Text="Selecione um probe para ver os detalhes coletados." FontSize="17" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="Os probes validam recursos específicos; não executam o arquivo importado." FontSize="14" Foreground="#AFCBD2" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
        <TextBlock x:Name="Status" Grid.Row="3" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#AFC4DE"/>
      </Grid>
    </Grid>
  </Viewbox>

  <Grid x:Name="AngleTestView" Visibility="Collapsed" Background="#050810">
    <SwapChainPanel x:Name="AnglePanel"/>
    <Border x:Name="AngleLoadingView" Width="560" Padding="36" Background="#F0141B29" BorderBrush="#365070" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <StackPanel Spacing="17">
        <ProgressBar IsIndeterminate="True" Height="5" Foreground="#26DCD6"/>
        <TextBlock Text="Carregando conteúdo" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border x:Name="AngleTestControls" VerticalAlignment="Bottom" Background="#E60B111C" Padding="30,22">
      <Grid><StackPanel Spacing="5"><TextBlock Text="XS4 · EXECUÇÃO" FontSize="14" CharacterSpacing="110" Foreground="#8CBDEB"/><TextBlock x:Name="AngleStatus" Text="Preparando superfície…" FontSize="16" TextWrapping="Wrap"/></StackPanel><Button x:Name="CloseAngleTest" Content="Voltar" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Border>
  </Grid>

  <Grid x:Name="GuestDialogOverlay" Visibility="Collapsed" Background="#E8041119">
    <Border Width="680" Padding="34" Background="#102630" BorderBrush="#26DCD6" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="20">
        <TextBlock Text="Mensagem do conteúdo" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="GuestDialogMessage" FontSize="18" Foreground="#DFEFF1" TextWrapping="Wrap" MaxHeight="330"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
          <Button x:Name="GuestDialogCancel" Content="B  Cancelar"/>
          <Button x:Name="GuestDialogAccept" Content="A  Continuar" Background="#19606A" BorderBrush="#26DCD6"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>

  <Grid x:Name="ShortcutOverlay" Visibility="Collapsed" Background="#D908183C">
    <Border Width="510" Padding="24" Background="#F0112B5B" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="8">
        <Button x:Name="ShortcutExport" Content="Exportar relatório" HorizontalAlignment="Stretch" Height="62" HorizontalContentAlignment="Left" Background="#193B70" BorderThickness="0"/>
        <Button x:Name="ShortcutResume" Content="Retomar processo" HorizontalAlignment="Stretch" Height="62" HorizontalContentAlignment="Left" Background="#193B70" BorderThickness="0" Visibility="Collapsed"/>
        <Button x:Name="ShortcutEnd" Content="Encerrar processo" HorizontalAlignment="Stretch" Height="62" HorizontalContentAlignment="Left" Background="#193B70" BorderThickness="0" Visibility="Collapsed"/>
        <Button x:Name="ShortcutExit" Content="Sair do XS4" HorizontalAlignment="Stretch" Height="62" HorizontalContentAlignment="Left" Background="#193B70" BorderThickness="0"/>
      </StackPanel>
    </Border>
  </Grid>

  <Grid x:Name="InstallOverlay" Visibility="Collapsed" Background="#DD05070C">
    <Border Width="650" Padding="32" Background="#141B28" BorderBrush="#354158" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="18">
        <TextBlock Text="Instalando conteúdo" FontSize="25"/>
        <TextBlock x:Name="InstallProgressText" Text="Preparando pacote…" FontSize="14" Foreground="#AAB7CB" TextWrapping="Wrap"/>
        <Grid><ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" Height="9" Foreground="#2694F3"/><TextBlock x:Name="InstallProgressPercent" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Margin="0,16,0,0" Foreground="#D7E4F5"/></Grid>
        <Button x:Name="CancelExtraction" Content="Cancelar" HorizontalAlignment="Right" Padding="22,11"/>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
